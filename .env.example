# JOBS AT RAIGARH — backend environment variables (never commit real secrets)
NODE_ENV=production
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/jobs_at_raigarh

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Private resume storage (S3 / GCS compatible)
STORAGE_BUCKET=jobs-at-raigarh-resumes
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
SIGNED_URL_TTL_SECONDS=300

# Notifications (Expo push)
EXPO_ACCESS_TOKEN=

# Optional mobile OTP provider
SMS_PROVIDER_KEY=

# Admin owner bootstrap
ADMIN_EMAIL=abhixfactor@gmail.com
ADMIN_PASSWORD=change-me-on-first-login
